---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { directiva } from '../data/directiva';
import cruzImg from '../assets/img/simbolos/cruzpotenzada.jpg';

const cuerpoDirectivo = directiva.filter((c) => c.tipo === 'directivo');
const asesores = directiva.filter((c) => c.tipo === 'asesor');
---

<BaseLayout
  title="Directiva"
  description="Junta directiva de la Cofradía del Santo Sepulcro y Jesús Cautivo de Monóvar."
>
  <PageHeader
    title="Directiva"
    subtitle="Actualmente la directiva de la Cofradía del Santo Sepulcro y Jesús Cautivo se compone de las siguientes personas."
    crumbs={[{ texto: 'La Cofradía' }, { texto: 'Directiva' }]}
  />

  <section class="contenedor py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <h2 class="reveal sobretitulo">Junta directiva</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {
            cuerpoDirectivo.map((cargo) => (
              <div class="reveal tarjeta">
                <p class="text-xs font-semibold uppercase tracking-amplio text-oro">{cargo.cargo}</p>
                <p class="mt-2 font-display text-xl font-semibold text-morado">{cargo.nombre}</p>
              </div>
            ))
          }
        </div>

        <h2 class="reveal sobretitulo mt-14">Asesores</h2>
        <ul class="reveal mt-6 divide-y divide-morado/10 overflow-hidden rounded-2xl border border-morado/10 bg-white/70">
          {
            asesores.map((asesor) => (
              <li class="flex items-center justify-between gap-4 px-6 py-4">
                <span class="text-sm text-carbon-claro">{asesor.cargo}</span>
                <span class="text-right font-medium text-morado">{asesor.nombre}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="reveal">
        <div class="sticky top-28 overflow-hidden rounded-3xl border border-morado/10 bg-white/80 shadow-suave">
          <img src={cruzImg.src} alt="Cruz potenzada, insignia de la cofradía" class="h-64 w-full object-cover" loading="lazy" />
          <div class="p-6">
            <p class="sobretitulo">La insignia</p>
            <p class="mt-3 text-sm leading-relaxed text-carbon-claro">
              Cruz potenzada con perfiles dorados y fondo rojo, puesta sobre un círculo blanco delimitado por
              circunferencia dorada.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
