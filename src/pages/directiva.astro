---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Escudo from '../components/Escudo.astro';
import { directiva } from '../data/directiva';

const cuerpoDirectivo = directiva.filter((c) => c.tipo === 'directivo');
const asesores = directiva.filter((c) => c.tipo === 'asesor');
---

<BaseLayout
  title="Directiva"
  description="Junta directiva de la Cofradía del Santo Sepulcro y Jesús Cautivo de Monóvar."
>
  <PageHeader
    title="Directiva"
    subtitle="Actualmente la directiva de la Cofradía del Santo Sepulcro y Jesús Cautivo se compone de las siguientes personas."
    crumbs={[{ texto: 'La cofradía' }, { texto: 'Directiva' }]}
  />

  <section class="panel">
    <div class="contenedor grid gap-12 py-16 lg:grid-cols-[1.2fr_0.8fr] lg:py-20">
      <div>
        <h2 class="etiqueta">Junta directiva</h2>
        <div class="mt-6 grid gap-px border border-habito/15 bg-habito/15 sm:grid-cols-2">
          {
            cuerpoDirectivo.map((cargo) => (
              <div class="bg-lienzo p-6">
                <p class="text-xs tracking-wide text-candela-oscuro">{cargo.cargo}</p>
                <p class="mt-2 font-display text-xl font-medium text-habito">{cargo.nombre}</p>
              </div>
            ))
          }
        </div>

        <h2 class="etiqueta mt-14">Asesores</h2>
        <dl class="mt-6 border-t border-habito/15">
          {
            asesores.map((asesor) => (
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-habito/15 py-4">
                <dt class="text-sm text-humo">{asesor.cargo}</dt>
                <dd class="text-right font-medium text-habito">{asesor.nombre}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="border border-habito/15 p-8 text-center">
          <Escudo class="mx-auto h-28 w-28" />
          <p class="mt-6 text-sm leading-relaxed text-humo">
            Cruz potenzada con perfiles dorados y fondo rojo, puesta sobre un círculo blanco delimitado por
            circunferencia dorada.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
