---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import { site } from '../data/site';

const videos = [
  { id: site.youtube.videoDestacado, titulo: 'Presentación de la Revista' },
  { id: site.youtube.videoDestacado, titulo: 'Salida del Santo Entierro' },
  { id: site.youtube.videoDestacado, titulo: 'Procesión de Jesús Cautivo' },
];
---

<BaseLayout title="Vídeos" description="Vídeos de las procesiones de la Cofradía del Santo Sepulcro de Monóvar.">
  <PageHeader
    title="Vídeos"
    subtitle="Revive las procesiones, las salidas y las entradas de nuestros tronos."
    crumbs={[{ texto: 'Multimedia' }, { texto: 'Vídeos' }]}
  />

  <section class="contenedor py-16 lg:py-20">
    <div class="reveal mx-auto max-w-4xl">
      <YoutubeEmbed videoId={site.youtube.videoDestacado} titulo={site.youtube.titulo} canal={site.youtube.canal} />
    </div>

    <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-2">
      {
        videos.map((video) => (
          <div class="reveal">
            <YoutubeEmbed videoId={video.id} titulo={video.titulo} />
          </div>
        ))
      }
    </div>

    <div class="reveal mx-auto mt-12 max-w-3xl text-center">
      <a href={site.youtube.canal} target="_blank" rel="noopener" class="boton-primario">
        Ver todos los vídeos en YouTube
      </a>
    </div>
  </section>
</BaseLayout>
