---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { procesiones } from '../data/procesiones';
import crismonImg from '../assets/img/procesiones/crismon.png';
import sepulcroProcesion from '../assets/img/santo-sepulcro/ss1.jpg';
import cautivoProcesion from '../assets/img/jesus-cautivo/cautivo.jpg';
import procesion1 from '../assets/img/procesiones/dsc0226.jpg';
import procesion2 from '../assets/img/procesiones/dsc0084.jpg';

const imagenes = { cautivo: cautivoProcesion, sepulcro: sepulcroProcesion };
---

<BaseLayout
  title="Procesiones"
  description="Procesiones de la Cofradía del Santo Sepulcro y Jesús Cautivo: Lunes Santo y Viernes Santo en Monóvar."
>
  <PageHeader
    title="Procesiones"
    subtitle="La cofradía del Santo Sepulcro procesiona por las calles de Monóvar desde el año 1942."
    imagen={procesion1}
    crumbs={[{ texto: 'Procesiones' }]}
  />

  <section class="contenedor py-16 lg:py-20">
    <div class="reveal mx-auto grid max-w-5xl gap-8 lg:grid-cols-2">
      <div class="prosa">
        <p>
          La cofradía del Santo Sepulcro procesiona por las calles de Monóvar desde el año 1942. Desde entonces y hasta
          la actualidad ha tenido cambios progresivos, desde su vestimenta hasta las transformaciones del trono. En un
          principio procesionaba con una talla más pequeña que la actual, con un trono blanco de cuatro trabajaderas
          portado por 6 costaleros. En 1944 se sustituyó la talla inicial por la que es la titular de la cofradía.
        </p>
        <p>
          Desde el año 2008, con la donación anónima de cuatro personas de la imagen de Jesús Cautivo, la cofradía salió
          por primera vez en su historia el Lunes Santo, incorporando un día más procesional a la Semana Santa monovera.
        </p>
      </div>
      <figure class="overflow-hidden rounded-3xl shadow-suave">
        <Image src={crismonImg} alt="Crismón de la cofradía" widths={[400, 600]} loading="lazy" class="h-full w-full object-cover" />
      </figure>
    </div>
  </section>

  <section class="bg-crema-oscuro/60 py-16 lg:py-20">
    <div class="contenedor">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="sobretitulo">Calendario</p>
        <h2 class="titulo-seccion mt-3">Nuestras procesiones</h2>
      </div>

      <div class="mt-12 space-y-10">
        {
          procesiones.map((procesion, indice) => (
            <article
              class:list={[
                'reveal grid items-center gap-8 overflow-hidden rounded-3xl border border-morado/10 bg-white/80 p-6 shadow-suave lg:grid-cols-2 lg:p-8',
              ]}
            >
              <div class:list={['overflow-hidden rounded-2xl shadow-suave', indice % 2 === 1 && 'lg:order-2']}>
                <Image
                  src={imagenes[procesion.imagen]}
                  alt={procesion.nombre}
                  widths={[500, 800, 1100]}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class:list={[indice % 2 === 1 && 'lg:order-1']}>
                <p class="sobretitulo">{procesion.dia}</p>
                <h3 class="mt-2 font-display text-3xl font-semibold text-morado">{procesion.nombre}</h3>
                <p class="mt-4 text-carbon-claro">{procesion.descripcion}</p>
                <dl class="mt-6 space-y-2 text-sm">
                  <div class="flex gap-2">
                    <dt class="font-semibold text-oro">Hora:</dt>
                    <dd class="text-carbon-claro">{procesion.hora} h</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="font-semibold text-oro">Salida:</dt>
                    <dd class="text-carbon-claro">{procesion.salida}</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="font-semibold text-oro">Itinerario:</dt>
                    <dd class="text-carbon-claro">{procesion.itinerario}</dd>
                  </div>
                </dl>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="contenedor py-16 lg:py-20">
    <div class="reveal mx-auto max-w-4xl rounded-3xl bg-morado p-8 text-crema sm:p-12">
      <p class="sobretitulo text-oro">Las procesiones de Monóvar</p>
      <p class="mt-4 leading-relaxed text-crema/85">
        Las procesiones de Monóvar se caracterizan por la labor desempeñada por las bandas de tambores y cornetas que, a
        base de ensayos, logran una calidad musical que atrae al público, así como la compenetración de los pasos con las
        bandas, sobre todo en las entradas y salidas de los tronos, y la belleza de todas sus imágenes y tronos.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <Image src={procesion2} alt="Procesión del Santo Sepulcro" widths={[500, 900]} loading="lazy" class="rounded-2xl object-cover" />
        <Image src={procesion1} alt="Banda en procesión" widths={[500, 900]} loading="lazy" class="rounded-2xl object-cover" />
      </div>
    </div>
  </section>
</BaseLayout>
