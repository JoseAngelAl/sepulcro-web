---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { banda, responsableBanda, anioBanda } from '../data/banda';
import bandaImg from '../assets/img/banda/647.jpg';
import bandaImg2 from '../assets/img/banda/b12.jpg';
import bandaImg3 from '../assets/img/banda/banda4.jpg';
import bandaImg4 from '../assets/img/banda/banda7.jpg';
---

<BaseLayout
  title="Nuestra banda"
  description="Banda de tambores y cornetas de la Cofradía del Santo Sepulcro de Monóvar."
>
  <PageHeader
    title="Nuestra banda"
    subtitle="La música que acompaña a nuestros tronos por las calles de Monóvar."
    imagen={bandaImg}
    crumbs={[{ texto: 'Agrupación' }, { texto: 'Nuestra banda' }]}
  />

  <section class="bg-noche">
    <div class="contenedor py-16 lg:py-20">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          [bandaImg3, bandaImg2, bandaImg4, bandaImg].map((img, i) => (
            <div class:list={['border border-lienzo/15', i === 0 && 'sm:col-span-2 sm:row-span-2']}>
              <Image src={img} alt="Banda de tambores y cornetas" widths={[400, 700]} loading="lazy" class="h-full w-full object-cover" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="panel border-t border-habito/15">
    <div class="contenedor py-16 lg:py-20">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <p class="etiqueta">Componentes</p>
          <h2 class="titulo-seccion mt-3">La banda en {anioBanda}</h2>
        </div>
        <div class="border border-habito/20 px-6 py-4 text-sm">
          <span class="text-humo">Responsable de la banda</span>
          <span class="mt-1 block font-display text-lg font-medium text-habito">{responsableBanda}</span>
        </div>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          banda.map((grupo) => (
            <div class="tarjeta">
              <h3 class="font-display text-xl font-medium text-habito">{grupo.instrumento}</h3>
              <p class="mt-1 text-xs tracking-wide text-candela-oscuro">{grupo.componentes.length} componentes</p>
              <ul class="mt-4 grid grid-cols-1 gap-1.5 text-sm text-humo sm:grid-cols-2">
                {grupo.componentes.map((componente) => <li>{componente}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
