---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { costaleros, pertigas, manijeroCapataz, ayudante, anioCostaleros } from '../data/costaleros';
import costalerosImg from '../assets/img/costaleros/645.jpg';
import costalerosImg2 from '../assets/img/costaleros/615.jpg';
---

<BaseLayout
  title="Costaleros"
  description="Costaleros de la Cofradía del Santo Sepulcro de Monóvar."
>
  <PageHeader
    title="Costaleros"
    subtitle="Quienes portan con devoción el trono del Santo Sepulcro por las calles de Monóvar."
    imagen={costalerosImg}
    crumbs={[{ texto: 'Agrupación' }, { texto: 'Costaleros' }]}
  />

  <section class="panel">
    <div class="contenedor py-16 lg:py-20">
      <div class="grid gap-6 md:grid-cols-3">
        <div class="tarjeta">
          <p class="etiqueta">Manijero y capataz</p>
          <p class="mt-3 font-display text-xl font-medium text-habito">{manijeroCapataz}</p>
        </div>
        <div class="tarjeta">
          <p class="etiqueta">Ayudante</p>
          <p class="mt-3 font-display text-xl font-medium text-habito">{ayudante}</p>
        </div>
        <div class="tarjeta">
          <p class="etiqueta">Pértigas</p>
          <ul class="mt-3 space-y-1 text-sm text-humo">
            {pertigas.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>

      <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:items-start">
        <div class="border border-habito/15 p-2">
          <Image
            src={costalerosImg2}
            alt="Costaleros de la cofradía"
            widths={[500, 800, 1100]}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>

        <div>
          <p class="etiqueta">Cuadrilla</p>
          <h2 class="mt-3 titulo-seccion">Costaleros {anioCostaleros}</h2>
          <ul class="mt-8 grid grid-cols-1 gap-x-8 gap-y-2 border border-habito/15 p-6 text-sm text-humo sm:grid-cols-2 lg:grid-cols-3">
            {costaleros.map((costalero) => <li>{costalero}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
