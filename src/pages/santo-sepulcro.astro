---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import sepulcroImg from '../assets/img/santo-sepulcro/ss1.jpg';
import procesionImg from '../assets/img/procesiones/p1.jpg';

const ficha = [
  { campo: 'Titular', valor: 'Cristo Yacente' },
  { campo: 'Autor', valor: 'José Mª Alarcón' },
  { campo: 'Año', valor: '1944' },
  { campo: 'Material', valor: 'Madera de pino policromada al óleo' },
  { campo: 'Restauración', valor: '2002, por Mónica Navarro Gozálvez' },
];
---

<BaseLayout
  title="Santo Sepulcro"
  description="El Cristo Yacente, imagen titular de la Cofradía del Santo Sepulcro de Monóvar."
>
  <PageHeader
    title="Santo Sepulcro"
    subtitle="La imagen titular de la cofradía, el Cristo Yacente, que procesiona cada Viernes Santo."
    imagen={sepulcroImg}
    crumbs={[{ texto: 'La Cofradía' }, { texto: 'Santo Sepulcro' }]}
  />

  <section class="contenedor grid gap-12 py-16 lg:grid-cols-2 lg:py-20">
    <div class="reveal overflow-hidden rounded-3xl shadow-elegante">
      <Image
        src={sepulcroImg}
        alt="Cristo Yacente, titular de la Cofradía del Santo Sepulcro"
        widths={[600, 900, 1200]}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>

    <div class="reveal flex flex-col justify-center">
      <p class="sobretitulo">Imagen titular</p>
      <h2 class="mt-3 titulo-seccion">Cristo Yacente</h2>
      <p class="prosa mt-4">
        Cristo Yacente tallado en madera de pino policromado al óleo, realizado por José Mª Alarcón en 1944 y restaurado
        en 2002 por Mónica Navarro Gozálvez. Escenifica la imagen de Cristo yacente en su losa sepulcral, sobre la sábana
        santa, que cubre parcialmente su cuerpo.
      </p>

      <dl class="mt-8 divide-y divide-morado/10 overflow-hidden rounded-2xl border border-morado/10 bg-white/70">
        {
          ficha.map((item) => (
            <div class="flex items-center justify-between gap-4 px-6 py-3.5">
              <dt class="text-sm font-semibold uppercase tracking-wide text-oro">{item.campo}</dt>
              <dd class="text-right text-sm text-carbon-claro">{item.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="bg-crema-oscuro/60 py-16 lg:py-20">
    <div class="contenedor">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="sobretitulo">En procesión</p>
        <h2 class="titulo-seccion mt-3">El Santo Entierro</h2>
        <p class="mt-4 text-carbon-claro">
          La imagen procesiona desde 1942 por las calles de Monóvar, portada por los costaleros y acompañada por la banda
          de tambores y cornetas.
        </p>
      </div>
      <div class="reveal mx-auto mt-10 max-w-4xl overflow-hidden rounded-3xl shadow-suave">
        <Image
          src={procesionImg}
          alt="El Santo Sepulcro en procesión"
          widths={[600, 1000, 1400]}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>
</BaseLayout>
