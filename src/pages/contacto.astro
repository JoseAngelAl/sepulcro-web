---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contacto" description="Contacta con la Cofradía del Santo Sepulcro de Monóvar.">
  <PageHeader
    title="Contacto"
    subtitle="Escríbenos para participar en la cofradía, resolver dudas o dejar tu mensaje en nuestro libro de visitas."
    crumbs={[{ texto: 'Contacto' }]}
  />

  <section class="panel">
    <div class="contenedor grid gap-12 py-16 lg:grid-cols-2 lg:py-20">
      <div>
        <p class="etiqueta">Estamos a tu disposición</p>
        <h2 class="titulo-seccion mt-3">Hablemos</h2>
        <p class="mt-5 max-w-md leading-relaxed text-humo">
          Ya sea para formar parte de la cofradía, para ofrecer tu colaboración o simplemente para dejarnos un mensaje,
          puedes contactar con nosotros a través de los siguientes medios.
        </p>

        <dl class="mt-10 space-y-6 border-t border-habito/15 pt-8">
          <div>
            <dt class="etiqueta">Correo electrónico</dt>
            <dd class="mt-2">
              <a href={`mailto:${site.email}`} class="enlace-oro font-medium">{site.email}</a>
            </dd>
          </div>
          <div>
            <dt class="etiqueta">Sede</dt>
            <dd class="mt-2 text-humo">{site.contacto.iglesia}</dd>
            <dd class="text-humo">{site.contacto.direccion}</dd>
          </div>
          <div>
            <dt class="etiqueta">Semana Santa</dt>
            <dd class="mt-2 text-humo">Lunes Santo y Viernes Santo</dd>
          </div>
        </dl>
      </div>

      <div>
        <form action="https://formspree.io/f/tu-id-de-formspree" method="POST" class="border border-habito/15 p-7 sm:p-9">
          <div class="space-y-6">
            <div>
              <label for="nombre" class="mb-2 block text-sm font-semibold text-habito">Nombre</label>
              <input
                id="nombre"
                name="nombre"
                type="text"
                required
                class="w-full border border-habito/25 bg-white px-4 py-3 text-sm text-habito focus:border-candela-oscuro focus:outline-none"
              />
            </div>
            <div>
              <label for="email" class="mb-2 block text-sm font-semibold text-habito">Correo electrónico</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="w-full border border-habito/25 bg-white px-4 py-3 text-sm text-habito focus:border-candela-oscuro focus:outline-none"
              />
            </div>
            <div>
              <label for="mensaje" class="mb-2 block text-sm font-semibold text-habito">Mensaje</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                class="w-full border border-habito/25 bg-white px-4 py-3 text-sm text-habito focus:border-candela-oscuro focus:outline-none"></textarea>
            </div>
          </div>
          <button type="submit" class="boton-primario mt-7 w-full">Enviar mensaje</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
