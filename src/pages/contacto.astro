---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contacto" description="Contacta con la Cofradía del Santo Sepulcro de Monóvar.">
  <PageHeader
    title="Contacto"
    subtitle="Escríbenos para participar en la cofradía, resolver dudas o dejar tu mensaje en nuestro libro de visitas."
    crumbs={[{ texto: 'Contacto' }]}
  />

  <section class="contenedor grid gap-12 py-16 lg:grid-cols-2 lg:py-20">
    <div class="reveal">
      <p class="sobretitulo">Estamos a tu disposición</p>
      <h2 class="titulo-seccion mt-3">Hablemos</h2>
      <p class="mt-4 text-carbon-claro">
        Ya sea para formar parte de la cofradía, para ofrecer tu colaboración o simplemente para dejarnos un mensaje,
        puedes contactar con nosotros a través de los siguientes medios.
      </p>

      <dl class="mt-8 space-y-5">
        <div class="flex items-start gap-4">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-amplio text-oro">Correo electrónico</dt>
            <dd class="mt-1">
              <a href={`mailto:${site.email}`} class="enlace-oro font-medium">{site.email}</a>
            </dd>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-amplio text-oro">Sede</dt>
            <dd class="mt-1 text-carbon-claro">{site.contacto.iglesia}</dd>
            <dd class="text-carbon-claro">{site.contacto.direccion}</dd>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-amplio text-oro">Semana Santa</dt>
            <dd class="mt-1 text-carbon-claro">Lunes Santo y Viernes Santo</dd>
          </div>
        </div>
      </dl>
    </div>

    <div class="reveal">
      <form
        action="https://formspree.io/f/tu-id-de-formspree"
        method="POST"
        class="tarjeta space-y-5"
      >
        <div>
          <label for="nombre" class="mb-1 block text-sm font-semibold text-morado">Nombre</label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            required
            class="w-full rounded-xl border border-morado/15 bg-white px-4 py-3 text-sm text-carbon focus:border-oro focus:outline-none"
          />
        </div>
        <div>
          <label for="email" class="mb-1 block text-sm font-semibold text-morado">Correo electrónico</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-xl border border-morado/15 bg-white px-4 py-3 text-sm text-carbon focus:border-oro focus:outline-none"
          />
        </div>
        <div>
          <label for="mensaje" class="mb-1 block text-sm font-semibold text-morado">Mensaje</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="5"
            required
            class="w-full rounded-xl border border-morado/15 bg-white px-4 py-3 text-sm text-carbon focus:border-oro focus:outline-none"></textarea>
        </div>
        <button type="submit" class="boton-primario w-full">Enviar mensaje</button>
        <p class="text-xs text-carbon-claro">
          Nota: configura el endpoint de Formspree para activar el envío del formulario.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>
