---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="contenedor flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="sobretitulo">Error 404</p>
    <h1 class="titulo-seccion mt-4">Página no encontrada</h1>
    <p class="mt-4 max-w-md text-carbon-claro">
      La página que buscas no existe o ha cambiado de dirección. Vuelve al inicio para continuar explorando la cofradía.
    </p>
    <a href="/" class="boton-primario mt-8">Volver al inicio</a>
  </section>
</BaseLayout>
