---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const { Content } = await noticia.render();
const formateador = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={noticia.data.title} description={noticia.data.resumen}>
  <PageHeader
    title={noticia.data.title}
    crumbs={[{ texto: 'Multimedia' }, { texto: 'Noticias', href: '/noticias' }, { texto: noticia.data.title }]}
  />

  <article class="contenedor mx-auto max-w-3xl py-16 lg:py-20">
    <time class="reveal sobretitulo" datetime={noticia.data.date.toISOString()}>
      {formateador.format(noticia.data.date)} · {noticia.data.author}
    </time>
    <div class="prosa reveal mt-6">
      <Content />
    </div>
    <a href="/noticias" class="enlace-oro mt-10 inline-block text-sm font-semibold">← Volver a noticias</a>
  </article>
</BaseLayout>
