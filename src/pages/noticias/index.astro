---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const noticias = (await getCollection('noticias')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formateador = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Noticias" description="Últimas noticias y convocatorias de la Cofradía del Santo Sepulcro de Monóvar.">
  <PageHeader
    title="Noticias"
    subtitle="Convocatorias, avisos y actualidad de la cofradía."
    crumbs={[{ texto: 'Multimedia' }, { texto: 'Noticias' }]}
  />

  <section class="bg-noche">
    <div class="contenedor py-16 lg:py-20">
      <div class="mx-auto max-w-3xl border-t border-lienzo/15">
        {
          noticias.map((noticia) => (
            <article class="border-b border-lienzo/15 py-9">
              <time class="etiqueta" datetime={noticia.data.date.toISOString()}>
                {formateador.format(noticia.data.date)}
              </time>
              <h2 class="mt-3 font-display text-2xl font-medium text-lienzo sm:text-3xl">{noticia.data.title}</h2>
              {noticia.data.resumen && <p class="mt-3 leading-relaxed text-lienzo/65">{noticia.data.resumen}</p>}
              <a href={`/noticias/${noticia.slug}`} class="enlace-oro mt-5 inline-block text-sm font-semibold">
                Leer la noticia
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
