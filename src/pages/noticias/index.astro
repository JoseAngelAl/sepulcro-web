---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const noticias = (await getCollection('noticias')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formateador = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Noticias" description="Últimas noticias y convocatorias de la Cofradía del Santo Sepulcro de Monóvar.">
  <PageHeader
    title="Noticias"
    subtitle="Convocatorias, avisos y actualidad de la cofradía."
    crumbs={[{ texto: 'Multimedia' }, { texto: 'Noticias' }]}
  />

  <section class="contenedor py-16 lg:py-20">
    <div class="mx-auto grid max-w-4xl gap-6">
      {
        noticias.map((noticia) => (
          <article class="reveal tarjeta">
            <div class="flex flex-wrap items-center gap-3">
              <time class="sobretitulo" datetime={noticia.data.date.toISOString()}>
                {formateador.format(noticia.data.date)}
              </time>
              <span class="text-xs text-carbon-claro">· {noticia.data.author}</span>
            </div>
            <h2 class="mt-3 font-display text-2xl font-semibold text-morado sm:text-3xl">{noticia.data.title}</h2>
            {noticia.data.resumen && <p class="mt-3 text-carbon-claro">{noticia.data.resumen}</p>}
            <a href={`/noticias/${noticia.slug}`} class="enlace-oro mt-4 inline-block text-sm font-semibold">
              Leer más →
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
