---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

import cover200 from '../../assets/img/revista/200.jpg';
import cover600 from '../../assets/img/revista/600.jpg';
import cover630 from '../../assets/img/revista/630.jpg';

const covers = { 200: cover200, 600: cover600, 630: cover630 } as const;

const revistas = (await getCollection('revista')).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Revista" description="Revistas de la Cofradía del Santo Sepulcro de Monóvar.">
  <PageHeader
    title="Revista"
    subtitle="Publicación anual de la cofradía, con artículos, memorias y colaboraciones de sus cofrades."
    crumbs={[{ texto: 'Multimedia' }, { texto: 'Revista' }]}
  />

  <section class="bg-noche">
    <div class="contenedor py-16 lg:py-20">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          revistas.map((revista) => (
            <a
              href={`/revista/${revista.slug}`}
              class="group flex flex-col border border-lienzo/15 bg-white/[0.03] transition-colors hover:border-candela/60"
            >
              <div class="aspect-[3/4] overflow-hidden border-b border-lienzo/15">
                <Image
                  src={covers[revista.data.cover]}
                  alt={revista.data.title}
                  widths={[300, 500]}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                />
              </div>
              <div class="p-6">
                <h2 class="font-display text-2xl font-medium text-lienzo">{revista.data.title}</h2>
                <span class="enlace-oro mt-3 inline-block text-sm font-semibold">Ver la revista</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
