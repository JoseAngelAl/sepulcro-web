---
import { Image } from 'astro:assets';
import insignia from '../assets/img/simbolos/logotipoCruz.jpg';

interface Props {
  class?: string;
}
const { class: clase = 'h-8 w-8' } = Astro.props;
---

<Image
  src={insignia}
  alt=""
  width={176}
  height={176}
  class:list={['rounded-full bg-white object-cover', clase]}
/>
