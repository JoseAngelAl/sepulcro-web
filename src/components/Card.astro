---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  titulo: string;
  texto?: string;
  imagen?: ImageMetadata;
  etiqueta?: string;
}

const { href, titulo, texto, imagen, etiqueta } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-2xl border border-morado/10 bg-white/80 shadow-suave backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:shadow-elegante"
>
  {
    imagen && (
      <div class="aspect-[4/3] overflow-hidden">
        <Image
          src={imagen}
          alt={titulo}
          widths={[400, 600, 800]}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    {etiqueta && <span class="sobretitulo">{etiqueta}</span>}
    <h3 class="mt-2 font-display text-xl font-semibold text-morado">{titulo}</h3>
    {texto && <p class="mt-2 flex-1 text-sm leading-relaxed text-carbon-claro">{texto}</p>}
    <span class="enlace-oro mt-4 text-sm font-semibold">Ver más →</span>
  </div>
</a>
