---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  titulo: string;
  texto?: string;
  imagen?: ImageMetadata;
  etiqueta?: string;
}

const { href, titulo, texto, imagen, etiqueta } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col border border-lienzo/15 bg-white/[0.03] transition-colors duration-200 hover:border-candela/60"
>
  {
    imagen && (
      <div class="aspect-[4/3] overflow-hidden border-b border-lienzo/15">
        <Image
          src={imagen}
          alt={titulo}
          widths={[400, 600, 800]}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    {etiqueta && <span class="etiqueta">{etiqueta}</span>}
    <h3 class="mt-2 font-display text-xl font-medium text-lienzo">{titulo}</h3>
    {texto && <p class="mt-2 flex-1 text-sm leading-relaxed text-lienzo/60">{texto}</p>}
    <span class="enlace-oro mt-5 text-sm font-semibold">Ver más</span>
  </div>
</a>
