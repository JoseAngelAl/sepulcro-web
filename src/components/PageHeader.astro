---
import { Image } from 'astro:assets';

interface Crumb {
  texto: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  imagen?: ImageMetadata;
  crumbs?: Crumb[];
}

const { title, subtitle, imagen, crumbs = [] } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-morado text-crema">
  {
    imagen && (
      <Image
        src={imagen}
        alt=""
        widths={[800, 1200, 1800]}
        loading="eager"
        class="absolute inset-0 -z-10 h-full w-full object-cover opacity-35"
      />
    )
  }
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-morado via-morado/85 to-morado/55"></div>

  <div class="contenedor py-14 sm:py-20 md:py-24">
    <nav aria-label="Ruta de navegación" class="mb-5 text-xs text-crema/60">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="transition-colors hover:text-oro">Inicio</a></li>
        {
          crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              {c.href ? (
                <a href={c.href} class="transition-colors hover:text-oro">
                  {c.texto}
                </a>
              ) : (
                <span class="text-crema/90">{c.texto}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <h1 class="font-display text-4xl font-semibold leading-tight text-crema sm:text-5xl md:text-6xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-base leading-relaxed text-crema/80">{subtitle}</p>}
  </div>
</section>
