---
import { Image } from 'astro:assets';

interface Crumb {
  texto: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  imagen?: ImageMetadata;
  crumbs?: Crumb[];
}

const { title, subtitle, imagen, crumbs = [] } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-noche text-lienzo">
  {
    imagen && (
      <Image
        src={imagen}
        alt=""
        widths={[800, 1200, 1800]}
        loading="eager"
        class="absolute inset-0 -z-10 h-full w-full object-cover opacity-25"
      />
    )
  }
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-noche via-noche/90 to-noche/60"></div>

  <div class="contenedor py-14 sm:py-20 md:py-24">
    <nav aria-label="Ruta de navegación" class="mb-6 text-xs text-lienzo/45">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="transition-colors hover:text-candela">Inicio</a></li>
        {
          crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="text-lienzo/25">/</span>
              {c.href ? (
                <a href={c.href} class="transition-colors hover:text-candela">
                  {c.texto}
                </a>
              ) : (
                <span class="text-lienzo/70">{c.texto}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <h1 class="font-display text-4xl font-medium leading-[1.05] tracking-tight text-lienzo sm:text-5xl md:text-6xl">
      {title}
    </h1>
    {subtitle && <p class="mt-5 max-w-2xl text-base leading-relaxed text-lienzo/65">{subtitle}</p>}
  </div>

  <div class="h-px w-full bg-candela/30"></div>
</section>
