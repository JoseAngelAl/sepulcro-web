---
import { site } from '../data/site';

const año = new Date().getFullYear();

const enlacesRapidos = [
  { texto: 'Historia', href: '/historia' },
  { texto: 'Procesiones', href: '/procesiones' },
  { texto: 'Nuestra Banda', href: '/nuestra-banda' },
  { texto: 'Costaleros', href: '/costaleros' },
  { texto: 'Noticias', href: '/noticias' },
];

const enlacesMultimedia = [
  { texto: 'Fotos', href: '/fotos' },
  { texto: 'Vídeos', href: '/videos' },
  { texto: 'Revista', href: '/revista' },
  { texto: 'Poesías dedicadas', href: '/poesias' },
  { texto: 'Enlaces', href: '/enlaces' },
];
---

<footer class="border-t border-morado/10 bg-morado text-crema">
  <div class="contenedor grid gap-12 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <p class="font-display text-2xl font-semibold text-crema">Santo Sepulcro</p>
      <p class="mt-1 text-xs font-semibold uppercase tracking-amplio text-oro">{site.localidad} · {site.provincia}</p>
      <p class="mt-5 text-sm leading-relaxed text-crema/70">
        Desde 1940, guardando y engrandeciendo la Semana Santa de Monóvar tras el Cristo Yacente y Jesús Cautivo.
      </p>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-amplio text-oro">La Cofradía</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {enlacesRapidos.map((e) => (
          <li>
            <a href={e.href} class="text-crema/80 transition-colors hover:text-oro">{e.texto}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-amplio text-oro">Multimedia</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {enlacesMultimedia.map((e) => (
          <li>
            <a href={e.href} class="text-crema/80 transition-colors hover:text-oro">{e.texto}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-amplio text-oro">Contacto</h3>
      <ul class="mt-4 space-y-2 text-sm text-crema/80">
        <li>{site.contacto.iglesia}</li>
        <li>{site.contacto.direccion}</li>
        <li>
          <a href={`mailto:${site.email}`} class="transition-colors hover:text-oro">{site.email}</a>
        </li>
      </ul>
      {
        site.redes.facebook || site.redes.instagram ? (
          <div class="mt-5 flex gap-3">
            {site.redes.facebook && (
              <a href={site.redes.facebook} class="text-crema/70 transition-colors hover:text-oro" aria-label="Facebook">
                Facebook
              </a>
            )}
            {site.redes.instagram && (
              <a href={site.redes.instagram} class="text-crema/70 transition-colors hover:text-oro" aria-label="Instagram">
                Instagram
              </a>
            )}
          </div>
        ) : (
          <a href="/contacto" class="boton-oro mt-5 px-5 py-2 text-xs">Escríbenos</a>
        )
      }
    </div>
  </div>

  <div class="border-t border-crema/10">
    <div class="contenedor flex flex-col items-center justify-between gap-2 py-5 text-xs text-crema/50 sm:flex-row">
      <p>© {año} {site.nombreLargo}. Todos los derechos reservados.</p>
      <p>Monóvar, Alicante · Semana Santa</p>
    </div>
  </div>
</footer>
