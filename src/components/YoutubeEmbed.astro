---
interface Props {
  videoId: string;
  titulo: string;
  canal?: string;
  portada?: string;
}

const { videoId, titulo, canal, portada } = Astro.props;
const miniatura = portada || `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
const miniaturaAlt = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<div
  class="group relative aspect-video overflow-hidden border border-candela/30 bg-noche-profunda shadow-marco"
  data-video
  data-id={videoId}
  data-titulo={titulo}
>
  <button
    type="button"
    class="absolute inset-0 z-10 flex h-full w-full items-center justify-center"
    aria-label={`Reproducir vídeo: ${titulo}`}
    data-video-boton
  >
    <img
      src={miniatura}
      alt=""
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      onerror={`this.onerror=null;this.src='${miniaturaAlt}'`}
    />
    <span class="absolute inset-0 bg-gradient-to-t from-noche-profunda/90 via-noche-profunda/20 to-transparent"></span>
    <span
      class="relative flex h-16 w-16 items-center justify-center border border-candela bg-noche/60 text-candela transition-colors duration-300 group-hover:bg-candela group-hover:text-noche"
    >
      <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7" aria-hidden="true">
        <path d="M8 5v14l11-7z" fill="currentColor" />
      </svg>
    </span>
  </button>

  <div class="pointer-events-none absolute bottom-0 left-0 z-10 p-6">
    <p class="text-xs tracking-wide text-candela">YouTube</p>
    <p class="mt-1 font-display text-xl font-medium text-lienzo sm:text-2xl">{titulo}</p>
  </div>
</div>

<script>
  const contenedor = document.querySelector<HTMLElement>('[data-video]');

  contenedor?.querySelector('[data-video-boton]')?.addEventListener('click', () => {
    const id = contenedor.dataset.id;
    if (!id) return;

    const iframe = document.createElement('iframe');
    iframe.className = 'absolute inset-0 h-full w-full';
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.title = contenedor.dataset.titulo || 'Vídeo de la cofradía';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.setAttribute('loading', 'lazy');

    contenedor.replaceChildren(iframe);
  });
</script>
